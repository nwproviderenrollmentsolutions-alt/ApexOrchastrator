# Copy to .env and fill in. Both keys are optional — the dashboard runs
# fully mocked with zero setup. See ../SETUP.md.

# Groq (LLM) — powers the Analyst + script-writing stages.
# Get a free key at https://console.groq.com/keys (no credit card).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# YouTube Data API v3 — real trending Shorts for the Viral Radar.
# Get a free key at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" first).
YOUTUBE_API_KEY=
YOUTUBE_REGION=US

# Render service (your cloned avatar + voice). Runs separately, on your GPU
# machine -- see ../render/README.md. Leave empty to skip video rendering
# and just get scripts.
RENDER_SERVICE_URL=

PORT=3000
