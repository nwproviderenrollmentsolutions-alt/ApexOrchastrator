# Copy to .env and fill in. Optional — the dashboard runs fully mocked without it.
# Get a free key at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" first). See ../SETUP.md.
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
PORT=3000

# No key needed for AI: the dashboard uses Puter.js in the browser, which
# authenticates against the viewer's free Puter.com account on first use.
