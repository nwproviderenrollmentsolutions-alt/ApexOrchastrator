# Copy to .env. Defaults are safe (mock mode, no GPU/models needed) --
# flip RENDER_MOCK=false once you've done the setup in README.md.

RENDER_MOCK=true
HOST=0.0.0.0
PORT=8000

# Paths are relative to this render/ directory unless absolute.
AVATAR_IMAGE_PATH=assets/avatar.png
VOICE_SAMPLE_PATH=assets/voice_sample.wav
OUTPUT_DIR=output

# Absolute path to your cloned SadTalker checkout (see README.md).
# Leave empty while RENDER_MOCK=true.
SADTALKER_DIR=

XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
