# Copy this file to .env and fill in your keys. Both are free tier — see SETUP.md.
# Any stage whose key is missing falls back to mocked/simulated data automatically.

# Groq (LLM) — powers Viral Analyst + UGC Creator's script writing.
# Get a free key at https://console.groq.com/keys (no credit card).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# YouTube Data API v3 — powers real trend data for Viral Radar (YouTube Shorts only).
# Get a free key at https://console.cloud.google.com/apis/credentials.
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
