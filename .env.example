# Copy to .env and fill in whichever free-tier keys you have.
# Every integration is optional -- missing keys downgrade that stage to an
# offline/mock fallback instead of crashing the pipeline.

# Script writing + QC judgment. Free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# B-roll stock footage. Free tier: https://www.pexels.com/api
PEXELS_API_KEY=

# YouTube Data API v3 (free daily quota). https://console.cloud.google.com
# Download an OAuth "Desktop app" client secret JSON and point this at it.
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=.secrets/youtube_token.json

# TikTok Content Posting API (free developer account). https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API (free Meta app + Business/Creator account).
# https://developers.facebook.com
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
# Graph API needs a public URL to fetch the rendered video from.
IG_PUBLIC_VIDEO_BASE_URL=

# Local web dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

APEX_RUNS_DIR=runs
